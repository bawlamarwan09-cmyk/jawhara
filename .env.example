# ─────────── Contact form email delivery ───────────
# RECOMMENDED — Web3Forms (no signup, free, using a verified company inbox):
#   1. Open https://web3forms.com/
#   2. Enter the verified company inbox in the "Create Access Key" field.
#   3. Web3Forms emails you an access key (UUID). Confirm via the link they send.
#   4. Paste the key below, save this file as .env.local, restart `npm run dev`.
NEXT_PUBLIC_WEB3FORMS_KEY=

# NEXT_PUBLIC_* values are included in browser code. Use only the provider's
# public form access key here—never an account password or private API secret.

# Optional alternative — Formspree:
#   1. Sign up at https://formspree.io/ and create a form for the verified company inbox.
#   2. Copy its endpoint URL (e.g. https://formspree.io/f/abcd1234)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# If both are empty, the form opens the visitor's mail client only when the
# verified contact email below is configured; otherwise it shows a safe retry message.

# Production origin used for canonical, Open Graph, robots.txt and sitemap.xml.
# Example format: https://www.example.com (do not add a trailing slash).
NEXT_PUBLIC_SITE_URL=

# ─────────── Verified public company details ───────────
# A value is exposed by content/site.js only when its matching *_VERIFIED flag is true.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_VERIFIED=false
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER_VERIFIED=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL_VERIFIED=false
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_ADDRESS_VERIFIED=false
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_FACEBOOK_URL_VERIFIED=false
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL_VERIFIED=false
NEXT_PUBLIC_LEGAL_IDENTITY=
NEXT_PUBLIC_LEGAL_IDENTITY_VERIFIED=false
NEXT_PUBLIC_EXPERIENCE_YEARS=
NEXT_PUBLIC_EXPERIENCE_YEARS_VERIFIED=false
