# ─────────── Contact form email delivery ───────────
# RECOMMENDED — Web3Forms (no signup, free, just your email):
#   1. Open https://web3forms.com/
#   2. Type jowharatech@gmail.com in the "Create Access Key" field, click Create
#   3. Web3Forms emails you an access key (UUID). Confirm via the link they send.
#   4. Paste the key below, save this file as .env.local, restart `npm run dev`.
#   Submissions then arrive in jowharatech@gmail.com.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional alternative — Formspree:
#   1. Sign up at https://formspree.io/ and create a form (target jowharatech@gmail.com)
#   2. Copy its endpoint URL (e.g. https://formspree.io/f/abcd1234)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# If both are empty, the form falls back to opening the visitor's mail client.
